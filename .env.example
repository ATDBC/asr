# LLM Configuration for Standalone Transcriber

# DeepSeek API Configuration
# Fill in your DeepSeek API key below:
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4.1-flash

# Xiaomi MiMo API Configuration
# Fill in your Xiaomi MiMo API key below:
MIMO_API_KEY=sk-your-mimo-api-key-here
# Optional overrides:
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.6-flash

# Alibaba DashScope (Qwen) API Configuration
# Fill in your DashScope API key below:
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
# Optional overrides:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen3.7-flash
